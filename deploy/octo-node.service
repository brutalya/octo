[Unit]
Description=Octo node (API on loopback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/root/apps/octo/target/release/octo-server --addr 127.0.0.1:7878 --data-dir /root/.local/share/octo
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# data dir + CLI state (Claude Code, Antigravity) that the agents write to
ReadWritePaths=/root/.local/share/octo /root/.claude /root/.gemini /root/.config

[Install]
WantedBy=multi-user.target
