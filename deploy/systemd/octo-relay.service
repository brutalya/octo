[Unit]
Description=Octo relay (relay only, no API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Private relay; drop --relay-secret-file for an open one. Secret: /var/lib/octo-relay/relay-secret
StateDirectory=octo-relay
ExecStart=/opt/octo/bin/octo-server --relay-only --relay-addr 0.0.0.0:7443 --relay-secret-file /var/lib/octo-relay/relay-secret
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
